/* ═══════════════════════════════════════════════════════════════════════
   Coro Pacem Deus — Reglas de seguridad Realtime Database (v3.6.8r1)
   ═══════════════════════════════════════════════════════════════════════
   QUÉ CAMBIA RESPECTO A LAS REGLAS VIVAS (v3.6.7r1)

     1. Lista de administradores en la propia base: /admins/{uid}: true.
        Las reglas ya no llevan el UID literal repetido seis veces. Sumar
        o quitar un administrador es crear o borrar un nodo, no editar
        reglas. Cada usuario puede LEER únicamente su propia entrada
        (auth.uid === $uid): así el cliente (AuthGate.isAdmin) sabe si la
        cuenta tiene permisos sin que la lista completa sea visible.

     2. /setlist-bodas deja de ser de lectura pública. Solo administradores
        autenticados leen y escriben. El Modo Bodas pasa a ser privado de
        verdad (antes cualquiera podía abrir setlist-bodas.json y ver
        fechas y nombres de novios). Los novios siguen sin tocar Firebase:
        su borrador vive en localStorage.

     3. /chord-history y /lyrics-history dejan de ser de lectura pública.
        Solo los lee el módulo 13 desde botones que existen únicamente
        con Edición activa.

     NO CAMBIA: /setlist (dominical) sigue de lectura pública porque los
     coristas, sin cuenta, lo leen en Modo Coro. /chord-overrides y
     /lyrics-overrides siguen públicos: son el contenido que ve el
     feligrés. /agent-feedback y /liturgical-card-feedback igual que antes.

   ═══════════════════════════════════════════════════════════════════════
   PASOS DE APLICACIÓN (en este orden; el paso 3 solo tras verificar que
   producción sirve v3.6.8r1 y que un visitante anónimo ya no pide
   /setlist-bodas)
   ═══════════════════════════════════════════════════════════════════════

     1. Console → Realtime Database → Datos → en la raíz crear el nodo
        admins y dentro la clave ihLzgmElwcRUvJrHRZOUOuMJoMF2 con valor
        true (booleano, no el texto "true").

     2. Segundo administrador (aldocardenas1209@gmail.com): esa cuenta
        debe iniciar sesión UNA vez en el cancionero (chip de modos →
        "Iniciar sesión"; verá "Esta cuenta no tiene permisos", es lo
        esperado). Luego Console → Authentication → Users: copiar el
        UID que aparece junto a ese correo y crear /admins/<ese UID>: true.
        Desde ese momento tiene exactamente los mismos permisos que Renzo.
        Para revocarlos, borrar el nodo.

     3. Console → Realtime Database → Reglas → pegar este archivo
        completo (los comentarios /* */ y // son válidos en Firebase;
        lo que Firebase RECHAZA son claves-comentario tipo "//path") →
        Publicar.

     4. Probar: en el cancionero, entrar a Bodas desde el chip, listar
        fechas, cargar una boda guardada, agregar un canto, recargar.
        Y comprobar en una ventana de incógnito que
        https://coropacemdeusdominical-default-rtdb.firebaseio.com/setlist-bodas.json
        responde "Permission denied".
   ═══════════════════════════════════════════════════════════════════════ */

{
  "rules": {
    ".read":  false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "chord-overrides": {
      ".read": true,
      "$cpdId": {
        ".write":    "auth != null && root.child('admins').child(auth.uid).val() === true && $cpdId.matches(/^cpd-[0-9]{3}$/)",
        ".validate": "newData.isString() && newData.val().length <= 50000"
      }
    },

    "lyrics-overrides": {
      ".read": true,
      "$cpdId": {
        ".write":    "auth != null && root.child('admins').child(auth.uid).val() === true && $cpdId.matches(/^cpd-[0-9]{3}$/)",
        ".validate": "newData.isString() && newData.val().length <= 100000"
      }
    },

    "chord-history": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$cpdId": {
        "$timestamp": {
          ".write":    "auth != null && root.child('admins').child(auth.uid).val() === true && $cpdId.matches(/^cpd-[0-9]{3}$/) && $timestamp.matches(/^[0-9]{10,16}$/)",
          ".validate": "newData.hasChildren(['content', 'savedAt']) && newData.child('content').isString() && newData.child('content').val().length <= 50000 && newData.child('savedAt').isNumber()"
        }
      }
    },

    "lyrics-history": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$cpdId": {
        "$timestamp": {
          ".write":    "auth != null && root.child('admins').child(auth.uid).val() === true && $cpdId.matches(/^cpd-[0-9]{3}$/) && $timestamp.matches(/^[0-9]{10,16}$/)",
          ".validate": "newData.hasChildren(['content', 'savedAt']) && newData.child('content').isString() && newData.child('content').val().length <= 100000 && newData.child('savedAt').isNumber()"
        }
      }
    },

    "setlist": {
      ".read": true,
      "$dateKey": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && $dateKey.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "$slotId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['cpd', 'title']) && newData.child('cpd').val().matches(/^cpd-[0-9]{3}$/) && newData.child('title').isString() && newData.child('title').val().length <= 200)"
        }
      }
    },

    "setlist-bodas": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$dateKey": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && $dateKey.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[0-9])?$/)",
        "_meta": {
          ".validate": "newData.hasChildren() && (!newData.hasChild('novios') || (newData.child('novios').isString() && newData.child('novios').val().length <= 200))"
        },
        "$slotId": {
          ".validate": "$slotId === '_meta' || !newData.exists() || (newData.child('cpd').exists() && newData.child('cpd').val().matches(/^cpd-[0-9]{3}$/)) || (newData.child('instrumental').exists() && newData.child('instrumental').val() === true)"
        }
      }
    },

    "agent-feedback": {
      ".read":  false,
      ".write": "newData.exists() && !data.exists()"
    },

    "liturgical-card-feedback": {
      ".read":  false,
      ".write": "newData.exists() && !data.exists()"
    }
  }
}
